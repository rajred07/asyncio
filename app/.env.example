# PlaylistGenius Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file.

# ── Database ──────────────────────────────────────────────────────────────
# Neon PostgreSQL async connection string
DATABASE_URL=postgresql+asyncpg://user:password@host/dbname

# ── Auth ──────────────────────────────────────────────────────────────────
# Generate a strong random key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here

# ── Redis (Upstash or local) ───────────────────────────────────────────────
REDIS_URL=rediss://default:password@host:port

# ── YouTube Data API v3 ───────────────────────────────────────────────────
YOUTUBE_API_KEY=your-youtube-api-key-here
YOUTUBE_CACHE_TTL=604800    # 7 days in seconds

# ── Redis (local Docker fallback — not used when REDIS_URL is set) ────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
